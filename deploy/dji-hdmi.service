[Unit]
Description=ungoggled HDMI receiver
After=network.target

[Service]
Type=simple
RuntimeDirectory=dji-hdmi
StateDirectory=dji-hdmi
Environment=GST_REGISTRY=/run/dji-hdmi/gstreamer-registry.bin
Environment=DJI_HDMI_DECODER=v4l2h264dec
EnvironmentFile=-/etc/default/dji-hdmi
ExecStartPre=/usr/local/lib/dji-hdmi/prepare-pi.sh
ExecStart=/opt/dji-hdmi/current/bin/ungoggled serve --listen 0.0.0.0:80 --web-dir /opt/dji-hdmi/current/web --decoder ${DJI_HDMI_DECODER}
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
